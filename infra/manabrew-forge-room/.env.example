# Copy to .env on the Synology/NAS and change the secrets.

# Shared relay access key. Keep private.
MANABREW_SERVER_KEY=change-me

# Password users need to join the room.
SELF_HOSTED_NODE_ROOM_PASSWORD=change-me-too

# Displayed room name in Manabrew.
SELF_HOSTED_NODE_ROOM_NAME=MTG-Commander PoC

# Commander table size.
SELF_HOSTED_NODE_MAX_PLAYERS=4

# Number of concurrently hosted rooms.
SELF_HOSTED_NODE_MAX_GAMES=1

