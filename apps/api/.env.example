# Local API binding. Production values belong in server-side container secrets.
API_HOST=127.0.0.1
API_PORT=8787

# Never expose these values through VITE_* variables or browser responses.
MANABREW_RELAY_URL=ws://127.0.0.1:9443
MANABREW_SERVER_KEY=replace-locally
MANABREW_API_USERNAME=mtg-commander-api
ZAI_API_KEY=replace-locally

# UI-003 live session: uncomment to let the API join as the interactive human
# seat (BOT-002 flow: find room, join, select deck, spawn bots, ready, start).
# MANABREW_ROOM_NAME=MTG-Commander PoC
# MANABREW_ROOM_PASSWORD=local-dev
# MANABREW_DECK_FILE=decks/dina-sacrifice.txt
# MANABREW_DECK_NAME=Dina Sacrifice
# MANABREW_DECK_OWNER=Korbi
# MANABREW_DECK_COMMANDER=Dina, Essence Brewer
# MANABREW_DECK_DISABLE=1        # join as observer, no deck/ready
# MANABREW_SPAWN_BOTS=1          # 0 disables bot spawning
# MANABREW_BOT_COUNT=3           # 1-3
